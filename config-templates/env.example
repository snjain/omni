# ~/.iceagentkit/env
# The ONE file a human edits for secrets. `iceagentkit setup` writes this once
# and propagates each value into whatever mechanism the relevant vendor tool
# actually reads (Omnigent's Gateway credentials, Headroom's own config -
# location unconfirmed, see PRD §16 item 10 - RTK's telemetry opt-in, etc.).
# chmod 600 this file once populated. See PRD §11.3.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GITHUB_TOKEN=
